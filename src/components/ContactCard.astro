---
// Product illustration: a contact card with a second card peeking out behind it.
// The data is made up, so screen readers get a short description instead.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const chips = ["подруга Маши", "конференция, Казань"];
const fields = [
  { label: "Телефон", value: "+7 912 345-67-89" },
  { label: "Почта", value: "anna@petrova.studio" },
];
---

<div
  role="img"
  aria-label="Пример карточки контакта: Анна Петрова, дизайнер интерфейсов, с телефоном, почтой и заметкой"
  class:list={["relative pt-3.5 lg:pt-4", className]}
>
  <div
    class="absolute inset-x-5.5 top-0 h-15 rounded-card bg-lavender-200 lg:inset-x-7 lg:h-20 lg:rounded-card-lg"
  >
  </div>
  <div
    class="relative flex flex-col items-center gap-3.5 rounded-card bg-white px-5 py-5.5 text-center shadow-card lg:gap-4 lg:rounded-card-lg lg:px-7 lg:py-8 lg:shadow-card-lg"
  >
    <div
      class="flex size-16 items-center justify-center rounded-full bg-coral-100 text-22 font-extrabold text-coral-700 lg:size-19 lg:text-26"
    >
      АП
    </div>
    <div class="flex flex-col gap-1">
      <p class="text-22 font-extrabold tracking-h3 lg:text-26">Анна Петрова</p>
      <p class="text-14 text-ink-muted lg:text-15">Дизайнер интерфейсов</p>
    </div>
    <div class="flex flex-wrap justify-center gap-1.5 lg:gap-2">
      {
        chips.map((chip) => (
          <span class="rounded-chip bg-lavender-100 px-3 py-1.5 text-13 font-semibold lg:px-3.5 lg:py-1.75 lg:text-14">
            {chip}
          </span>
        ))
      }
    </div>
    <!-- Phones narrower than 390px stack the fields, otherwise the email sticks out of the card -->
    <div class="grid w-full grid-cols-1 gap-2 min-[390px]:grid-cols-2 lg:gap-2.5 lg:text-left">
      {
        fields.map((field) => (
          <div class="flex flex-col gap-0.5 rounded-field bg-lavender-50 p-2.5 lg:rounded-field-lg lg:px-3.5 lg:py-3">
            <span class="text-12 text-ink-muted">{field.label}</span>
            <span class="text-14 font-semibold lg:text-15">{field.value}</span>
          </div>
        ))
      }
    </div>
    <div
      class="flex w-full flex-col gap-1.5 rounded-note bg-note p-3.5 text-left lg:rounded-note-lg lg:px-4.5 lg:py-4"
    >
      <p class="text-12 font-extrabold text-note-ink lg:text-13">12 окт.</p>
      <p class="text-15 leading-note lg:text-16 lg:leading-text">
        Созвонились. Ищет юриста для своей студии — прислать ей контакт Олега. Созвониться после
        отпуска, в ноябре.
      </p>
    </div>
  </div>
</div>
