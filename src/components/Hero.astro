---
// Block 1 of the landing: the offer and the first button
import ContactCard from "./ContactCard.astro";
import CtaButton from "./CtaButton.astro";
---

<section
  aria-labelledby="hero-title"
  class="mx-auto flex max-w-page flex-col gap-8 px-gutter pt-8 pb-section text-center lg:flex-row lg:items-center lg:gap-16 lg:px-gutter-lg lg:pt-12 lg:pb-28 lg:text-left"
>
  <div class="flex flex-col gap-8 lg:min-w-0 lg:flex-[1_1_440px] lg:items-start lg:gap-10">
    <div class="flex flex-col items-center gap-4.5 lg:items-start lg:gap-5.5">
      <p
        class="rounded-chip bg-white px-4 py-2 text-14 font-semibold text-ink-chip lg:px-4.5 lg:py-2.25 lg:text-15"
      >
        Не для продаж — для своих людей
      </p>
      <h1 id="hero-title" class="text-h1 font-extrabold lg:text-h1-lg">
        Помните каждого, с&nbsp;кем знакомы
      </h1>
      <p class="text-17 leading-text text-ink-soft lg:max-w-130 lg:text-20">
        Кто это, откуда знакомы, телефон, почта и о чём договорились — в одной карточке на каждого
        человека. Нашли по имени, открыли, вспомнили.
      </p>
    </div>
    <CtaButton note="Работает в браузере — на телефоне и компьютере" align="start" />
  </div>

  <ContactCard class="lg:mx-auto lg:max-w-card lg:min-w-0 lg:flex-[1_1_380px]" />
</section>
